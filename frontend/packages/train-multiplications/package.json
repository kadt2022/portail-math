{
  "name": "@mbuyamba/train-multiplications",
  "version": "0.1.0",
  "private": true,
  "description": "Le Train des multiplications 3D : jeu ferroviaire de Yamba Academy, sous forme de module autonome.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./infrastructure": "./src/infrastructure.ts"
  },
  "scripts": {
